@page "{id:int}"
@model HiddenListR.Pages.Events.DetailsModel
@{
    ViewData["Title"] = Model.Event?.Title ?? "Event";
}

@if (Model.Event is null)
{
    <p>Event not found.</p>
}
else
{
    @if (!Model.HideBackLink)
    {
        <p><a asp-page="/Events/Index">Back to Events</a></p>
    }
    <h1>@Model.Event.Title</h1>

    <ot-dropdown>
        <button type="button" popovertarget="viewItemsMenu" class="outline">
            Viewing @Model.CurrentViewLabel
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
        </button>
        <menu popover id="viewItemsMenu">
            <a asp-page="/Events/Details" asp-route-id="@Model.Event.Id" asp-route-active_view="@Model.CurrentUser!.Id" role="menuitem" class="unstyled">My List</a>
            <a asp-page="/Events/Details" asp-route-id="@Model.Event.Id" asp-route-active_view="my-claims" role="menuitem" class="unstyled">My Claimed Items</a>
            <hr>
            @foreach (var wl in Model.OtherWishLists)
            {
                var initial = wl.User.LastName.Length == 0 ? "" : wl.User.LastName[0].ToString();
                <a asp-page="/Events/Details" asp-route-id="@Model.Event.Id" asp-route-active_view="@wl.User.Id" role="menuitem" class="unstyled">@(wl.User.FirstName) @(initial)'s List - @wl.Items.Count items</a>
            }
        </menu>
    </ot-dropdown>

    <div class="hstack gap-2 mb-4 mt-4">
        @if (Model.CanShowClaimCounts)
        {
            <span class="badge" data-variant="success">@Model.ClaimedCount items claimed</span>
            <span class="badge">@Model.NotClaimedCount items not claimed</span>
        }
        <span class="badge outline">@Model.TotalItems total items</span>
    </div>

    @if (Model.ShowingClaimedItems)
    {
        if (Model.ClaimedItems.Count == 0)
        {
            <p>You haven't claimed any items in this event yet.</p>
        }
        else
        {
            <div class="vstack">
                @foreach (var claimed in Model.ClaimedItems)
                {
                    <partial name="_WishListItemCard" model="new DetailsModel.WishListItemCardModel(claimed.Item, Model.Event.Id, Model.CurrentUser!.IsAdmin(), claimed.OwnerUserId, false, Model.CanClaimItems, ItemClaimState.ClaimedByMe, claimed.CreatedBy, Model.ActiveView)" />
                }
            </div>
        }
    }
    else if (Model.SelectedOtherList is null)
    {
        if (Model.MyItems.Count == 0)
        {
            <p>You haven't added any items yet.</p>
        }
        else
        {
            <div class="vstack">
                @foreach (var item in Model.MyItems)
                {
                    <partial name="_WishListItemCard" model="new DetailsModel.WishListItemCardModel(item, Model.Event.Id, true, Model.CurrentUser!.Id, false, false, ItemClaimState.None, null, Model.ActiveView)" />
                }
            </div>
        }
        @if (Model.CanAddItems)
        {
            <button type="button" class="mt-4" commandfor="addItemDialog" command="show-modal">Add New Item</button>
        }
    }
    else
    {
        var list = Model.SelectedOtherList;
        if (list.Items.Count == 0)
        {
            <p>No wish list items yet.</p>
        }
        else
        {
            <div class="vstack">
                @foreach (var item in list.Items)
                {
                    <partial name="_WishListItemCard" model="new DetailsModel.WishListItemCardModel(item.Item, Model.Event.Id,
                            Model.CurrentUser!.IsAdmin(), list.User.Id,
                            item.Claim == ItemClaimState.None && Model.CanClaimItems,
                            item.Claim == ItemClaimState.ClaimedByMe && Model.CanClaimItems,
                            item.Claim, null, Model.ActiveView)" />
                }
            </div>
        }
        @if (Model.CanAddItems)
        {
            <button type="button" class="mt-4" commandfor="addItemDialog" command="show-modal">Add Item for @Model.AddItemOwnerName</button>
        }
    }

    @if (Model.CanAddItems)
    {
        <dialog id="addItemDialog" closedby="any">
            <form method="post" asp-page-handler="AddItem" asp-route-id="@Model.Event.Id">
                <input type="hidden" name="ownerUserId" value="@Model.AddItemOwnerUserId" />
                <input type="hidden" name="active_view" value="@Model.ActiveView" />
                <header><h3>Add Wish List Item</h3></header>
                <div>
                    <label data-field>
                        Title
                        <input asp-for="Input.Title" required maxlength="200" />
                        <span asp-validation-for="Input.Title"></span>
                    </label>
                    <label data-field>
                        Description
                        <textarea asp-for="Input.Description" maxlength="1000"></textarea>
                    </label>
                    <label data-field>
                        Product URL
                        <input asp-for="Input.ProductUrl" type="url" maxlength="500" />
                        <span asp-validation-for="Input.ProductUrl"></span>
                    </label>
                </div>
                <footer>
                    <button type="button" class="outline" commandfor="addItemDialog" command="close">Cancel</button>
                    <button type="submit">Add Item</button>
                </footer>
            </form>
        </dialog>
    }
}
